# Local run: plain HTTP on :80. On the VPS compose.yml sets the domains and
# the Cloudflare Origin Certificate.
{$SITE_ADDRESS::80} {
	{$SITE_TLS}

	root * /srv
	encode zstd gzip

	# Code and resources change on every release; revalidate them.
	header Cache-Control "no-cache"

	# Every page is the same Compose app; it reads the URL itself.
	try_files {path} /index.html

	file_server
}
