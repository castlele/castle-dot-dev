# Local run: plain HTTP on :80. On the VPS compose.yml sets the domains and
# the Cloudflare Origin Certificate.
{$SITE_ADDRESS::80} {
	{$SITE_TLS}

	root * /srv
	encode zstd gzip

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
