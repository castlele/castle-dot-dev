{$SITE_DOMAIN} {
	# On the VPS: "tls /certs/origin.pem /certs/origin.key"
	# (Cloudflare Origin Certificate). Empty for a local run.
	{$SITE_TLS}

	root * /srv
	encode zstd gzip

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
